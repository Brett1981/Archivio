<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Archivio.Application/Archivio.Application.csproj" />
    <ProjectReference Include="../Archivio.Infrastructure/Archivio.Infrastructure.csproj" />
    <ProjectReference Include="../Archivio.Persistence/Archivio.Persistence.csproj" />
    <ProjectReference Include="../Archivio.Media/Archivio.Media.csproj" />
    <ProjectReference Include="../Archivio.Metadata/Archivio.Metadata.csproj" />
    <ProjectReference Include="../Archivio.Workers/Archivio.Workers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
