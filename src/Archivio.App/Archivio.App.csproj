<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\Branding\metaroq.ico</ApplicationIcon>
    <Product>Metaroq</Product>
    <AssemblyTitle>Metaroq</AssemblyTitle>
    <Description>Media that finally makes sense.</Description>
    <!-- Temporarily disable app host generation to avoid file lock issues during build -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Archivio.Application/Archivio.Application.csproj" />
    <ProjectReference Include="../Archivio.Infrastructure/Archivio.Infrastructure.csproj" />
    <ProjectReference Include="../Archivio.Persistence/Archivio.Persistence.csproj" />
    <ProjectReference Include="../Archivio.Media/Archivio.Media.csproj" />
    <ProjectReference Include="../Archivio.Metadata/Archivio.Metadata.csproj" />
    <ProjectReference Include="../Archivio.Workers/Archivio.Workers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\metaroq-icon.png" />
    <Content Include="Assets\Branding\metaroq.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
