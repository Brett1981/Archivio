<Application x:Class="Archivio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Metaroq brand palette -->
        <Color x:Key="MetaroqDeepSlateColor">#1F1F2A</Color>
        <Color x:Key="MetaroqMetaBlueColor">#3A6CF0</Color>
        <Color x:Key="MetaroqSoftAquaColor">#7FE0D6</Color>
        <Color x:Key="MetaroqWarmSandColor">#E8D7C5</Color>
        <Color x:Key="MetaroqGraphiteColor">#2C2C2C</Color>

        <SolidColorBrush x:Key="MetaroqBackground" Color="#15151E" />
        <SolidColorBrush x:Key="MetaroqPanel" Color="{StaticResource MetaroqDeepSlateColor}" />
        <SolidColorBrush x:Key="MetaroqSurface" Color="#171724" />
        <SolidColorBrush x:Key="MetaroqSurfaceRaised" Color="#252536" />
        <SolidColorBrush x:Key="MetaroqBorder" Color="#38384A" />
        <SolidColorBrush x:Key="MetaroqAccent" Color="{StaticResource MetaroqMetaBlueColor}" />
        <SolidColorBrush x:Key="MetaroqAqua" Color="{StaticResource MetaroqSoftAquaColor}" />
        <SolidColorBrush x:Key="MetaroqSand" Color="{StaticResource MetaroqWarmSandColor}" />
        <SolidColorBrush x:Key="MetaroqText" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MetaroqMutedText" Color="#A7AEC0" />
        <SolidColorBrush x:Key="MetaroqSubtleText" Color="#717A90" />

        <Style x:Key="MetaroqButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource MetaroqSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetaroqBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetaroqText}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30304A" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource MetaroqAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202034" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaroqPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MetaroqButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MetaroqAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetaroqAccent}" />
        </Style>

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MetaroqButtonStyle}" />

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource MetaroqSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetaroqBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetaroqText}" />
            <Setter Property="CaretBrush" Value="{StaticResource MetaroqAqua}" />
            <Setter Property="SelectionBrush" Value="{StaticResource MetaroqAccent}" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <!-- The native WPF drop-down popup uses a light system surface. Keep its
                 text explicitly dark so it remains readable in every Windows theme. -->
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="Foreground" Value="#111827" />
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource MetaroqAccent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCE7FF" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource MetaroqText}" />
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{StaticResource MetaroqAccent}" />
            <Setter Property="Background" Value="{StaticResource MetaroqSurface}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
