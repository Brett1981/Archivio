<Window x:Class="Archivio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ArchivioBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ARCHIVIO" Foreground="{StaticResource ArchivioAccent}" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Library sources" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="Choose the folders Archivio will catalogue and understand."
                       Foreground="#9CA3AF" FontSize="15" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource ArchivioPanel}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="Configured folders" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right"
                                Content="New source"
                                Command="{Binding NewSourceCommand}"
                                Padding="14,7"
                                MinWidth="105" />
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding LibrarySources}"
                             SelectedItem="{Binding SelectedSource}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding Path}" Foreground="#94A3B8" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Type}" Foreground="{StaticResource ArchivioAccent}" Margin="0,5,0,0" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding IsEnabled, StringFormat=Enabled: {0}}"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Top"
                                                   Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource ArchivioPanel}" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Source details" Foreground="White" FontSize="20" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Name" Foreground="#CBD5E1" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Folder" Foreground="#CBD5E1" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" Padding="14,8" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Content type" Foreground="#CBD5E1" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding SourceTypes}"
                                  SelectedItem="{Binding SourceType}"
                                  Padding="8" />
                    </StackPanel>

                    <CheckBox Grid.Row="8"
                              Content="Enabled"
                              IsChecked="{Binding SourceIsEnabled}"
                              Foreground="White"
                              VerticalAlignment="Center" />

                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Padding="16,9"
                                MinWidth="90" />
                        <Button Grid.Column="2"
                                Content="Save source"
                                Command="{Binding SaveCommand}"
                                Padding="16,9"
                                HorizontalAlignment="Right"
                                MinWidth="120" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource ArchivioAccent}" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=Version {0}}" Foreground="#6B7280" />
        </DockPanel>
    </Grid>
</Window>
