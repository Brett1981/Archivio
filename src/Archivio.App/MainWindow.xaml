<Window x:Class="Archivio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ArchivioBackground}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ARCHIVIO" Foreground="{StaticResource ArchivioAccent}" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Your personal digital archivist" Foreground="White" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="A safe foundation for cataloguing, understanding and organising your collection."
                       Foreground="#9CA3AF" FontSize="16" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource ArchivioPanel}" CornerRadius="12" Padding="28">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Milestone 1 complete" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="WPF · MVVM · Dependency Injection · Logging · SQLite · Migrations · Tests"
                           Foreground="#9CA3AF" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                <Border Background="#0F172A" CornerRadius="8" Padding="16,10" Margin="0,24,0,0">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource ArchivioAccent}" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Version, StringFormat=Version {0}}" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </Grid>
</Window>
