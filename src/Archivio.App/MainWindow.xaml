<Window x:Class="Archivio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1360" Height="820" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource MetaroqBackground}"
        Foreground="{StaticResource MetaroqText}" FontFamily="Segoe UI"
        Icon="Assets/Branding/metaroq-icon.png"
        PreviewKeyDown="HandleWindowPreviewKeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="52" Height="52" Source="Assets/Branding/metaroq-icon.png" Stretch="Uniform" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Metaroq" Foreground="{StaticResource MetaroqText}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource MetaroqMutedText}" FontSize="12" Margin="1,2,0,0">
                    <Run Text="Media that " /><Run Text="finally" Foreground="{StaticResource MetaroqAqua}" /><Run Text=" makes sense." />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="Library catalogue" Foreground="{StaticResource MetaroqText}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="Scan safely, understand every file, and prepare an organised library."
                           Foreground="{StaticResource MetaroqMutedText}" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource MetaroqPanel}" BorderBrush="{StaticResource MetaroqBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="0.72*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="1.28*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Configured folders" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="New source" Command="{Binding NewSourceCommand}" Padding="12,6" />
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding LibrarySources}" SelectedItem="{Binding SelectedSource}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MetaroqSurface}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource MetaroqAqua}" Margin="0,4,0,0" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Row="4">
                        <TextBlock Text="Indexed media" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Foreground="#94A3B8">
                            <Run Text="{Binding VisibleMediaItemCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding MediaItemCount, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding MissingMediaItemCount, Mode=OneWay}" /><Run Text=" missing" />
                        </TextBlock>
                    </DockPanel>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="9,6" ToolTip="Search file name, relative path, or extension" />
                        <CheckBox Grid.Column="2" Content="Missing only" IsChecked="{Binding ShowMissingOnly}" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Grid.Row="8" ItemsSource="{Binding MediaItemsView}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MetaroqSurface}" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RelativePath}" Foreground="#94A3B8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Extension}" Foreground="{StaticResource MetaroqAqua}" HorizontalAlignment="Right" />
                                            <TextBlock Text="Missing" Foreground="#F59E0B" FontSize="11" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource MetaroqPanel}" BorderBrush="{StaticResource MetaroqBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Source details" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Name" Foreground="#CBD5E1" Margin="0,16,0,5" />
                        <TextBox Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" />
                        <TextBlock Text="Folder" Foreground="#CBD5E1" Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" Padding="11,7" />
                        </Grid>
                        <TextBlock Text="Content type" Foreground="#CBD5E1" Margin="0,12,0,5" />
                        <ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}" Padding="7" />
                        <CheckBox Content="Enabled" IsChecked="{Binding SourceIsEnabled}" Foreground="White" Margin="0,12,0,0" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="14,8" />
                            <Button Grid.Column="1" Content="Save source" Command="{Binding SaveCommand}" Style="{StaticResource MetaroqPrimaryButtonStyle}" Padding="14,8" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Background="{StaticResource MetaroqSurface}" CornerRadius="8" Padding="13" Margin="0,20,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStage}" Foreground="{StaticResource MetaroqAqua}" Margin="12,0,0,0" />
                                    <TextBlock Text="Scan catalogue" Foreground="White" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding ScanCurrentPath}" Foreground="#94A3B8" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Minimum="0" Maximum="{Binding ScanProgressMaximum}" Value="{Binding ScanProcessedCount}" Height="8" Margin="0,9,0,0">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="IsIndeterminate" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanStage}" Value="Starting"><Setter Property="IsIndeterminate" Value="True" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScanStage}" Value="Discovering"><Setter Property="IsIndeterminate" Value="True" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Foreground="#CBD5E1" Margin="0,7,0,0" TextWrapping="Wrap">
                                    <Run Text="Discovered " /><Run Text="{Binding ScanDiscoveredCount, Mode=OneWay}" /><Run Text="  Added " /><Run Text="{Binding ScanAddedCount, Mode=OneWay}" />
                                    <Run Text="  Refreshed " /><Run Text="{Binding ScanRefreshedCount, Mode=OneWay}" /><Run Text="  Missing " /><Run Text="{Binding ScanMissingCount, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Cancel" Command="{Binding CancelScanCommand}" Padding="12,6" />
                                    <Button Content="Scan now" Command="{Binding StartScanCommand}" Style="{StaticResource MetaroqPrimaryButtonStyle}" Padding="12,6" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Background="{StaticResource MetaroqPanel}" BorderBrush="{StaticResource MetaroqBorder}" BorderThickness="1" CornerRadius="12" Padding="18"
                    PreviewMouseLeftButtonDown="HandleReviewPanelPreviewMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="4" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Panel.ZIndex" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="5" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="ReviewWorkspaceGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ReviewCandidateColumn" Width="*" />
                        <ColumnDefinition x:Name="ReviewColumnGap" Width="0" />
                        <ColumnDefinition x:Name="ReviewDetailsColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition x:Name="ReviewCandidateRow" Height="0.8*" />
                        <RowDefinition x:Name="ReviewRowGap" Height="14" />
                        <RowDefinition x:Name="ReviewDetailsRow" Height="1.2*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.ColumnSpan="3">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="34" Height="34" Source="Assets/Branding/metaroq-icon.png" Stretch="Uniform" Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Audiobook review" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Read-only metadata intelligence" Foreground="{StaticResource MetaroqSubtleText}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Focus review" Command="{Binding EnterReviewFocusCommand}" Padding="13,7" Margin="0,0,8,0"
                                    ToolTip="Expand the review panel across the workspace">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MetaroqButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Back to catalogue" Command="{Binding ExitReviewFocusCommand}" Padding="13,7" Margin="0,0,8,0"
                                    ToolTip="Restore the catalogue and source panels (Esc)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MetaroqButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Cancel" Command="{Binding CancelAudiobookAnalysisCommand}" Padding="13,7" Margin="0,0,8,0" />
                            <Button Content="Analyse" Command="{Binding AnalyseAudiobooksCommand}" Style="{StaticResource MetaroqPrimaryButtonStyle}" Padding="13,7" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="{Binding AudiobookReviewCountLabel}" Foreground="#CBD5E1" Margin="0,0,14,0" />
                        <TextBlock Foreground="#CBD5E1" Margin="0,0,14,0"><Run Text="{Binding MultipartAudiobookCount, Mode=OneWay}" /><Run Text=" multipart" /></TextBlock>
                        <TextBlock Foreground="#CBD5E1" Margin="0,0,14,0"><Run Text="{Binding SingleFileAudiobookCount, Mode=OneWay}" /><Run Text=" single" /></TextBlock>
                        <TextBlock Foreground="#F59E0B" Margin="0,0,14,0"><Run Text="{Binding AudiobooksNeedingReviewCount, Mode=OneWay}" /><Run Text=" need review" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqAqua}" Margin="0,0,14,0"><Run Text="{Binding OnlineSuggestionCount, Mode=OneWay}" /><Run Text=" online suggestions" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqAccent}" Margin="0,0,14,0"><Run Text="{Binding OrganisationPlanCount, Mode=OneWay}" /><Run Text=" plans" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqAqua}" Margin="0,0,14,0"><Run Text="{Binding AlreadyOrganisedPlanCount, Mode=OneWay}" /><Run Text=" already organised" /></TextBlock>
                        <TextBlock Foreground="#F59E0B" Margin="0,0,14,0"><Run Text="{Binding MetadataReviewPlanCount, Mode=OneWay}" /><Run Text=" metadata review" /></TextBlock>
                        <TextBlock Foreground="#F59E0B" Margin="0,0,14,0"><Run Text="{Binding BatchConflictCount, Mode=OneWay}" /><Run Text=" conflicts" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqAqua}" Margin="0,0,14,0"><Run Text="{Binding BulkApprovalEligibleCount, Mode=OneWay}" /><Run Text=" bulk-safe singles" /></TextBlock>
                        <TextBlock Foreground="#F59E0B" Margin="0,0,14,0"><Run Text="{Binding IndividualApprovalRequiredCount, Mode=OneWay}" /><Run Text=" multi-file review" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqSand}" Margin="0,0,14,0"><Run Text="{Binding BatchApprovedCount, Mode=OneWay}" /><Run Text=" approved" /></TextBlock>
                        <TextBlock Foreground="{StaticResource MetaroqAqua}" Margin="0,0,14,0"><Run Text="{Binding BatchExecutableOperationCount, Mode=OneWay}" /><Run Text=" executable files" /></TextBlock>
                        <TextBlock Foreground="#F59E0B"><Run Text="{Binding BatchBlockedCount, Mode=OneWay}" /><Run Text=" blocked" /></TextBlock>
                    </WrapPanel>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                        <DockPanel>
                            <TextBlock Text="{Binding AudiobookAnalysisStatus}" Foreground="{StaticResource MetaroqAccent}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="10">
                                <Run Text="{Binding AudiobookAnalysisProcessedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding AudiobookAnalysisTotalCount, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="{Binding AudiobookAnalysisProgressMaximum}" Value="{Binding AudiobookAnalysisProcessedCount}" Height="6" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding AudiobookAnalysisCurrentPath}" Foreground="#64748B" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AudiobookAnalysisStorageStatus}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding OnlineMetadataStatus}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding OrganisationStatus}" Foreground="{StaticResource MetaroqAccent}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding BatchPlanningStatus}" Foreground="{StaticResource MetaroqSand}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding AudiobookExecutionStatus}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="10">
                                <Run Text="{Binding AudiobookExecutionProcessedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding AudiobookExecutionTotalCount, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="{Binding AudiobookExecutionProgressMaximum}" Value="{Binding AudiobookExecutionProcessedCount}" Height="4" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AudiobookExecutionCurrentPath}" Foreground="#64748B" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBox Text="{Binding AudiobookSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,7,0,0" ToolTip="Search audiobook title, author, or file path" />
                        <UniformGrid Columns="3" Margin="0,6,0,0">
                            <UniformGrid.Resources>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Margin" Value="0,0,12,6" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </UniformGrid.Resources>
                            <CheckBox Content="Needs review" IsChecked="{Binding ShowAudiobooksNeedingReviewOnly}"
                                      ToolTip="Show candidates that still need review" />
                            <CheckBox Content="Organisation plans" IsChecked="{Binding ShowOrganisationPlansOnly}"
                                      ToolTip="Show primary organisation plans that are not marked Needs review" />
                            <CheckBox Content="Automation-ready" IsChecked="{Binding ShowAutomaticReadyPlansOnly}"
                                      ToolTip="Show plans eligible for future unattended handling" />
                            <CheckBox Content="Metadata warnings" IsChecked="{Binding ShowAudiobookMetadataWarningsOnly}"
                                      ToolTip="Also require one or more local metadata warnings" />
                            <CheckBox Content="Multipart" IsChecked="{Binding ShowMultipartAudiobooksOnly}"
                                      ToolTip="Also require more than one source file" />
                            <CheckBox Content="Online suggestions" IsChecked="{Binding ShowOnlineSuggestionsOnly}"
                                      ToolTip="Also require a saved online suggestion" />
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,2,0,0">
                            <Button Content="{Binding ApproveSafeBatchLabel}" Command="{Binding ApproveSafeBatchCommand}" Padding="8,5" Margin="0,0,8,0"
                                    ToolTip="Approve only clean, 100%-confidence single-file audiobooks. Multi-file plans always require individual review." />
                            <Button Content="Defer blocked" Command="{Binding DeferBlockedBatchCommand}" Padding="8,5" Margin="0,0,8,0"
                                    ToolTip="Mark review-required and conflicting plans as deferred" />
                            <Button Content="Reset decisions" Command="{Binding ResetBatchDecisionsCommand}" Padding="8,5"
                                    ToolTip="Return all saved batch decisions to pending" />
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Button Content="Execute approved" Command="{Binding ExecuteApprovedBatchCommand}" Style="{StaticResource MetaroqPrimaryButtonStyle}" Padding="8,5" Margin="0,0,8,0"
                                    ToolTip="Revalidate and execute approved move/rename operations with a persistent rollback journal" />
                            <Button Content="Recover interrupted" Command="{Binding RecoverInterruptedExecutionCommand}" Padding="8,5" Margin="0,0,8,0"
                                    ToolTip="Safely restore files recorded by an interrupted execution" />
                            <Button Content="Cancel execution" Command="{Binding CancelAudiobookExecutionCommand}" Padding="8,5"
                                    ToolTip="Stop execution and roll back completed moves" />
                        </UniformGrid>
                        <TextBlock Text="Execution is always confirmed, revalidated, journalled, and non-overwriting. Combining and deletion remain disabled."
                                   Foreground="#94A3B8" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="6" ItemsSource="{Binding AudiobookCandidatesView}" SelectedItem="{Binding SelectedAudiobookCandidate}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MetaroqSurface}" BorderBrush="{StaticResource MetaroqBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReviewAuthorDisplay}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ReviewTitle}" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ReviewItemSummary}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ReviewPlannedResult, StringFormat=Planned result: {0}}" Foreground="{StaticResource MetaroqAccent}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding BatchApprovalSummary}" Foreground="{StaticResource MetaroqSand}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding BatchPlan.DecisionLabel}" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ReviewConfidence, StringFormat={}{0:P0}}" Foreground="{StaticResource MetaroqAqua}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ReviewItemStatusLabel}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MetaroqAqua}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ReviewItemNeedsReview}" Value="True"><Setter Property="Foreground" Value="#F59E0B" /></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="CandidateDetailsPanel" Grid.Row="8" Background="{StaticResource MetaroqSurface}" BorderBrush="{StaticResource MetaroqBorder}" BorderThickness="1" CornerRadius="8" Padding="13">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedAudiobookCandidate}">
                                <TextBlock Text="Audiobook plan" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReviewAuthorDisplay, TargetNullValue=Select an audiobook}" Foreground="#94A3B8" Margin="0,9,0,0" />
                                <TextBlock Text="{Binding ReviewTitle}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Foreground="#CBD5E1" Margin="0,7,0,0"><Run Text="{Binding ReviewItemSummary, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ReviewConfidence, Mode=OneWay, StringFormat={}{0:P0}}" /></TextBlock>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Planned result" Foreground="{StaticResource MetaroqAqua}" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ReviewPlannedResult}" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Files remain separate and ordered; no source file is deleted or overwritten." Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="How should Metaroq handle this audiobook?" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <Border Background="#202034" BorderBrush="{StaticResource MetaroqAccent}" BorderThickness="1" CornerRadius="6" Padding="9">
                                    <StackPanel>
                                        <RadioButton Content="{Binding ReviewHandlingLabel}" IsChecked="True" IsHitTestVisible="False" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ReviewHandlingDetail}" Foreground="#94A3B8" FontSize="10" Margin="22,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="9" Margin="0,6,0,0" Opacity="0.55">
                                    <StackPanel>
                                        <RadioButton Content="Move to one folder only" IsEnabled="False" Foreground="White" />
                                        <TextBlock Text="Planned option — preserve current filenames" Foreground="#94A3B8" FontSize="10" Margin="22,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="9" Margin="0,6,0,0" Opacity="0.55">
                                    <StackPanel>
                                        <RadioButton Content="Combine into one audiobook file" IsEnabled="False" Foreground="White" />
                                        <TextBlock Text="Available after format and chapter-boundary checks are implemented" Foreground="#94A3B8" FontSize="10" Margin="22,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Collection structure" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="If every source file is a complete book, split this collection before confirming individual titles. Metaroq will check each book online separately."
                                                   Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Series name (optional)" Foreground="#CBD5E1" FontSize="10" Margin="0,8,0,3" />
                                        <TextBox Text="{Binding DataContext.SelectedAudiobookSeriesName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="For example, Earth Chronicles" />
                                        <Button Content="These source files are separate books"
                                                Style="{StaticResource MetaroqPrimaryButtonStyle}"
                                                Command="{Binding DataContext.SeparateSelectedCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,5" Margin="0,7,0,0"
                                                ToolTip="Create one independently reviewed audiobook plan per source file" />
                                        <TextBlock Text="{Binding DataContext.AudiobookCollectionCorrectionStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{StaticResource MetaroqAqua}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Online suggestion" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <Image Source="{Binding OnlineSuggestion.CoverUrl}" Width="110" Height="160" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,2,0,6">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OnlineSuggestion.CoverUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding OnlineSuggestion.Title}" Foreground="{StaticResource MetaroqAqua}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OnlineSuggestion.AuthorDisplay}" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding OnlineSuggestion.YearDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding OnlineSuggestion.ProvenanceDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding OnlineSuggestion.SubjectDisplay}" Foreground="#64748B" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OnlineSuggestion.MatchReason}" Foreground="#64748B" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Organisation plan" Foreground="White" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <TextBlock Text="{Binding OrganisationProposal.CanonicalDisplay}" Foreground="{StaticResource MetaroqAccent}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding OrganisationProposal.ActionLabel, Mode=OneWay}" /><Run Text="  ·  " />
                                    <Run Text="{Binding OrganisationProposal.GenreCategory, Mode=OneWay}" /><Run Text="  ·  " />
                                    <Run Text="{Binding OrganisationProposal.Confidence, Mode=OneWay, StringFormat={}{0:P0}}" />
                                </TextBlock>
                                <TextBlock Text="{Binding OrganisationProposal.GroupSummary}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OrganisationProposal.ReadinessLabel}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Source evidence" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="Select a source file to compare its original name, folder, and embedded metadata before correcting the audiobook."
                                                   Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <ListBox ItemsSource="{Binding DataContext.SelectedAudiobookSourceEvidence, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 SelectedItem="{Binding DataContext.SelectedAudiobookSourcePart, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                 Background="{StaticResource MetaroqSurface}" BorderBrush="{StaticResource MetaroqBorder}"
                                                 BorderThickness="1" MaxHeight="130" Margin="0,8,0,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Sequence}" Foreground="{StaticResource MetaroqAqua}" FontWeight="SemiBold" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding MediaItem.FileName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding MediaItem.RelativePath}" Foreground="#94A3B8" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Background="{StaticResource MetaroqSurface}" CornerRadius="4" Padding="8" Margin="0,7,0,0"
                                                DataContext="{Binding DataContext.SelectedAudiobookSourcePart, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Foreground="#CBD5E1" TextWrapping="Wrap">
                                                    <Run Text="Original filename: " /><Run Text="{Binding MediaItem.FileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" />
                                                </TextBlock>
                                                <TextBlock Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    <Run Text="Library path: " /><Run Text="{Binding MediaItem.RelativePath, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="#CBD5E1" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap">
                                                    <Run Text="Embedded title: " /><Run Text="{Binding Metadata.TitleDisplay, Mode=OneWay}" />
                                                    <Run Text="  ·  Author: " /><Run Text="{Binding Metadata.AuthorDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                                    <Run Text="Album: " /><Run Text="{Binding Metadata.AlbumDisplay, Mode=OneWay}" />
                                                    <Run Text="  ·  " /><Run Text="{Binding Metadata.ReleaseDetailsDisplay, Mode=OneWay}" />
                                                    <Run Text="  ·  " /><Run Text="{Binding Metadata.DurationDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Play selected source file"
                                                Command="{Binding DataContext.PlaySelectedAudiobookSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,5" Margin="0,7,0,0" HorizontalAlignment="Left"
                                                ToolTip="Open this source file in the Windows default audio player" />
                                        <TextBlock Text="{Binding DataContext.AudiobookPreviewStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{StaticResource MetaroqAqua}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Confirm author and title" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OrganisationProposal.IdentitySourceLabel}"
                                                   Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Author" Foreground="#CBD5E1" FontSize="10" Margin="0,8,0,3" />
                                        <TextBox Text="{Binding DataContext.SelectedAudiobookAuthorOverride, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter the complete author name" />
                                        <TextBlock Text="Audiobook title" Foreground="#CBD5E1" FontSize="10" Margin="0,7,0,3" />
                                        <TextBox Text="{Binding DataContext.SelectedAudiobookTitleOverride, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter the complete audiobook title, not a chapter name" />
                                        <UniformGrid Columns="2" Margin="0,7,0,0">
                                            <Button Content="Save author/title correction" Style="{StaticResource MetaroqPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.ApplySelectedIdentityOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5" Margin="0,0,6,0"
                                                    ToolTip="Save this identity and immediately revalidate the plan" />
                                            <Button Content="Use Metaroq identity"
                                                    Command="{Binding DataContext.ResetSelectedIdentityOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5"
                                                    ToolTip="Remove your saved author and title correction" />
                                        </UniformGrid>
                                        <TextBlock Text="{Binding DataContext.AudiobookIdentityCorrectionStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{StaticResource MetaroqAqua}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Optional series metadata" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="Metaroq uses this to create a series folder and writes the series name into the embedded audio metadata during approved execution."
                                                   Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,7,0">
                                                <TextBlock Text="Series name" Foreground="#CBD5E1" FontSize="10" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding DataContext.SelectedAudiobookSeriesName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Book number" Foreground="#CBD5E1" FontSize="10" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding DataContext.SelectedAudiobookSeriesPosition, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <UniformGrid Columns="2" Margin="0,7,0,0">
                                            <Button Content="Save series details" Style="{StaticResource MetaroqPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.ApplySelectedSeriesOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5" Margin="0,0,6,0" />
                                            <Button Content="Clear series details"
                                                    Command="{Binding DataContext.ResetSelectedSeriesOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Confirm genre" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding OrganisationProposal.GenreSourceLabel, Mode=OneWay}" /><Run Text=" · Choose the library category for this audiobook." />
                                        </TextBlock>
                                        <ComboBox Margin="0,8,0,0" Padding="7,5"
                                                  ItemsSource="{Binding DataContext.AudiobookGenreCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedAudiobookGenreOverride, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Choose the genre folder for this audiobook" />
                                        <UniformGrid Columns="2" Margin="0,7,0,0">
                                            <Button Content="Confirm genre" Style="{StaticResource MetaroqPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.ApplySelectedGenreOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5" Margin="0,0,6,0"
                                                    ToolTip="Save this genre and immediately revalidate the plan" />
                                            <Button Content="Use Metaroq suggestion"
                                                    Command="{Binding DataContext.ResetSelectedGenreOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,5"
                                                    ToolTip="Remove your saved genre correction and restore automatic classification" />
                                        </UniformGrid>
                                        <TextBlock Text="{Binding DataContext.AudiobookReviewCorrectionStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{StaticResource MetaroqAqua}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Suggested destination" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock Text="{Binding OrganisationProposal.DestinationDisplay}" Foreground="{StaticResource MetaroqAccent}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OrganisationProposal.FutureOptionLabel}" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding OrganisationProposal.Reasons}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <ItemsControl ItemsSource="{Binding OrganisationProposal.Warnings}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="Batch dry run" Foreground="White" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <TextBlock Text="{Binding BatchApprovalValidationLabel}" Foreground="{StaticResource MetaroqSand}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BatchPlan.DecisionLabel}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                    <Button Content="Approve selected" Style="{StaticResource MetaroqPrimaryButtonStyle}"
                                            Command="{Binding DataContext.ApproveSelectedBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Padding="8,5" Margin="0,0,6,0"
                                            ToolTip="Approve this plan when all safety checks pass" />
                                    <Button Content="Defer selected"
                                            Command="{Binding DataContext.DeferSelectedBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Padding="8,5" Margin="0,0,6,0"
                                            ToolTip="Defer this plan for later review" />
                                    <Button Content="Reset selected"
                                            Command="{Binding DataContext.ResetSelectedBatchDecisionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Padding="8,5"
                                            ToolTip="Return this plan to decision pending" />
                                </UniformGrid>
                                <TextBlock Text="Decision only — no folders or media files will be changed."
                                           Foreground="#94A3B8" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding BatchPlan.Warnings}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Expander Header="{Binding SourceFilesDisclosureLabel}" Foreground="White" Margin="0,9,0,0">
                                    <ItemsControl ItemsSource="{Binding BatchPlan.Operations}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="4" Padding="7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Display}" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                                <TextBlock Text="Confidence explanation" Foreground="White" FontWeight="SemiBold" Margin="0,13,0,6" />
                                <ItemsControl ItemsSource="{Binding ConfidenceReasons}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="Warnings" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Expander Header="All technical source metadata" Foreground="White" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Parts}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{StaticResource MetaroqSurfaceRaised}" CornerRadius="4" Padding="8" Margin="0,0,0,7">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sequence}" Foreground="{StaticResource MetaroqAqua}" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding MediaItem.FileName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Metadata.TitleDisplay, Mode=OneWay}" /><Run Text="  ·  " />
                                                    <Run Text="{Binding Metadata.Title.SourceDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Metadata.AuthorDisplay, Mode=OneWay}" /><Run Text="  ·  " />
                                                    <Run Text="{Binding Metadata.Author.SourceDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="#64748B" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="Album: " /><Run Text="{Binding Metadata.AlbumDisplay, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Metadata.Album.SourceDisplay, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Foreground="#64748B" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="Genre: " /><Run Text="{Binding Metadata.GenreDisplay, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Metadata.Genre.SourceDisplay, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Foreground="#64748B" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Metadata.DurationDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Metadata.ReleaseDetailsDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Metadata.TechnicalSummary}" Foreground="#64748B" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Foreground="#64748B" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Metadata.ArtworkDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Metadata.SourceHintsDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding OrderingStatus}" Foreground="{StaticResource MetaroqAqua}" FontSize="10" Margin="0,3,0,0" />
                                                <ItemsControl ItemsSource="{Binding Metadata.Warnings}"><ItemsControl.ItemTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#F59E0B" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReviewFocusMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=Version {0}}" Foreground="#6B7280" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <Image Width="18" Height="18" Source="Assets/Branding/metaroq-icon.png" Stretch="Uniform" Margin="0,0,7,0" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MetaroqAqua}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
